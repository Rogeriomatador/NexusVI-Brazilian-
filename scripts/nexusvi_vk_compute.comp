#version 450
layout(local_size_x = 64) in;
layout(set=0,binding=0,std430) buffer Data { uint words[]; } data;
layout(push_constant) uniform Parameters { uint count; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<pc.count && i<data.words.length()) data.words[i]=data.words[i]*3u+7u;
}
